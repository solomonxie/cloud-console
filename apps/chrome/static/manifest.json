{
  "manifest_version": 3,
  "name": "Chrome Cloud Console",
  "version": "0.4.0",
  "description": "Browse S3, Azure, GCS, COS and OSS storage, plus Google Cloud VMs and secrets, from a Chrome side panel. Keys stay local.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Chrome Cloud Console",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "sidePanel", "downloads"],
  "host_permissions": [
    "https://*.amazonaws.com/*",
    "https://*.r2.cloudflarestorage.com/*",
    "https://storage.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://*.blob.core.windows.net/*",
    "https://*.myqcloud.com/*",
    "https://*.aliyuncs.com/*",
    "https://compute.googleapis.com/*",
    "https://secretmanager.googleapis.com/*",
    "https://cloudresourcemanager.googleapis.com/*"
  ],
  "optional_host_permissions": ["https://*/*"]
}
